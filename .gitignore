
# ==========================================
# FloodSiren - Git Ignore Rules
# ==========================================

# ------------------------------------------
# Environment variables and secrets
# ------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Firebase Admin service account credentials
serviceAccountKey.json
service-account*.json
*-firebase-adminsdk-*.json

# ------------------------------------------
# Node.js dependencies
# ------------------------------------------
node_modules/
jspm_packages/
web_modules/
.pnp
.pnp.js
.pnp.*

# npm
.npm/
npm-debug.log*
.npm-debug.log

# Yarn
.yarn-integrity
yarn-debug.log*
yarn-error.log*
.pnp.*

# pnpm
.pnpm-store/
.pnpm-debug.log*

# Package archives
*.tgz

# ------------------------------------------
# Next.js and frontend build output
# ------------------------------------------
.next/
out/
.turbo/
.vercel/

# Other framework build output and caches
.nuxt/
.output/
.vuepress/dist/
.temp/
.svelte-kit/
**/.vitepress/dist/
**/.vitepress/cache/
.docusaurus/
.astro/
.vite/
.cache/
.parcel-cache/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Build output
/build/
/dist/

# ------------------------------------------
# TypeScript and frontend tooling
# ------------------------------------------
*.tsbuildinfo
.eslintcache
.stylelintcache
.node_repl_history
.tern-port
.vscode-test/

# ------------------------------------------
# Logs and diagnostic reports
# ------------------------------------------
logs/
*.log
lerna-debug.log*
.pnpm-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------
# Runtime and temporary files
# ------------------------------------------
pids/
*.pid
*.seed
*.pid.lock
*.tmp
*.temp

# ------------------------------------------
# Testing and code coverage
# ------------------------------------------
coverage/
*.lcov
.nyc_output/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# ------------------------------------------
# Python
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class

# Python virtual environments
.venv/
venv/
ENV/
env/

# Python packaging and build artifacts
.python-version.local
build/
dist/
*.egg-info/
.eggs/
wheels/
pip-wheel-metadata/

# ------------------------------------------
# Firebase local development
# ------------------------------------------
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log

# ------------------------------------------
# Other tools and generated files
# ------------------------------------------
lib-cov/
.grunt/
bower_components/
.lock-wscript
build/Release/
.serverless/
.fusebox/
.dynamodb/

# ------------------------------------------
# Editors and operating systems
# ------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------
# Optional local database files
# Uncomment only if these are local-only databases
# that should never be committed.
# ------------------------------------------
# *.sqlite
# *.sqlite3
# *.db
